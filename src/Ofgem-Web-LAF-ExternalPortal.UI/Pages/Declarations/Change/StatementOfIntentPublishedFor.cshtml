@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Ofgem_Web_LAF_ExternalPortal.Extensions
@model SoiPublishedForModel

@{
    ViewData["Title"] = "Statement of Intent published for - LA Flex - Ofgem";
}

<a data-test-id="BackButton" class="govuk-back-link"
   asp-page="@LafPages.DeclarationDetail.ROUTE"
   asp-page-handler="@LafPages.DeclarationDetail.METHOD_USE_CACHED_DATA"
   asp-route-declarationId="@Model.DeclarationId">Back</a>


@if (Model != null)
{
    <!-- Error summary  -->
    @if (Model.HasError)
    {
        @await Html.PartialAsync("Shared/_ChangeErrors", Model.DisplayMessage)
    }

    <form method="POST">

        <input type="hidden" asp-for="DeclarationId" />
        <input type="hidden" asp-for="Urn" />

        <span class="govuk-caption-l">Change declaration details for @Model.Urn</span>

        <div class="govuk-form-group">

            <fieldset class="govuk-fieldset">

                <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">

                    <h1 class="govuk-fieldset__heading">
                        What Ofgem scheme has your organisation published its Statement of Intent for?
                    </h1>

                </legend>

                <div class="govuk-radios" data-module="govuk-radios">
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input" id="PublishedForECO4" type="radio" asp-for="SoiPublishedFor" value="ECO4 Flex">
                        <label class="govuk-label govuk-radios__label" for="PublishedForECO4">
                            ECO4 Flex
                        </label>

                    </div>

                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input" id="PublishedForGBIS" type="radio" asp-for="SoiPublishedFor" value="GBIS">
                        <label class="govuk-label govuk-radios__label" for="PublishedForGBIS">
                            GBIS
                        </label>

                    </div>

                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input" id="SoiPublishedForECO4AndGBIS" type="radio" asp-for="SoiPublishedFor" value="ECO4 Flex and GBIS">
                        <label class="govuk-label govuk-radios__label" for="SoiPublishedForECO4AndGBIS">
                            ECO4 Flex and GBIS
                        </label>

                    </div>
                </div>

            </fieldset>

        </div>

        <div class="govuk-button-group">

            <button type="submit" class="govuk-button" data-module="govuk-button">
                Save and continue
            </button>

            <a asp-page="@LafPages.DeclarationDetail.ROUTE"
               asp-page-handler="@LafPages.DeclarationDetail.METHOD_USE_CACHED_DATA"
               asp-route-declarationId="@Model.DeclarationId">
                Cancel
            </a>

        </div>

    </form>
}
