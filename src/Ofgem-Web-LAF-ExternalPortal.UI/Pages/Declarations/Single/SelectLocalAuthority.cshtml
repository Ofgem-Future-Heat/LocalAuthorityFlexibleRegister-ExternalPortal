@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Ofgem_Web_LAF_ExternalPortal.Extensions
@model SelectLocalAuthority
@{
    ViewData["Title"] = "Select local authority - LA Flex - Ofgem";
}

<input id="menuToSelect" type="hidden" value="@(LafPageMenus.SEND_DECLARATIONS)" />

<a data-test-id="BackButton" asp-page="@LafPages.SendDeclaration.ROUTE" class="govuk-back-link">Back</a>

<!-- Error summary  -->
@if (Model.HasError)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">
                There is a problem
            </h2>
            <div class="govuk-error-summary__body">
                <ul data-test-id="ErrorList" class="govuk-list govuk-error-summary__list laflex-error-list">
                    <li>
                        <a href="#@Model.ErrorId"> @Model.DisplayMessage</a>
                    </li>
                </ul>
                <br />
            </div>
        </div>
    </div>
}

@if (Model.SingleDeclarationJourney is not null)
{

    <form method="POST">

        <span class="govuk-caption-l">Create a single declaration notification</span>

        <div class="govuk-form-group @(Model.HasError ? "govuk-form-group--error" : "")">

            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                    <h1 class="govuk-fieldset__heading">
                        Select the local authority that is submitting the declaration notification
                    </h1>
                </legend>

                <div class="govuk-radios" data-module="govuk-radios">

                    @if (Model.SingleDeclarationJourney?.BaseLocalAuthority is not null)
                    {
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input"
                                   id="SelectLa"
                                   name="SelectedLa"
                                   type="radio"
                                   value="@Model.SingleDeclarationJourney.BaseLocalAuthority.OnsCode"
                                   asp-for="SelectedLa">

                            <label class="govuk-label govuk-radios__label" for="SelectLa">
                                @Model.SingleDeclarationJourney.BaseLocalAuthority.Name
                            </label>
                        </div>
                    }

                    @if (Model.SingleDeclarationJourney?.BaseLocalAuthority is not null &&
                   Model.SingleDeclarationJourney.LocalAuthorityList.Count > 0)
                    {
                        <div class="govuk-radios__divider">or</div>
                    }

                    @if (Model.SingleDeclarationJourney is not null)
                    {

                        @foreach (var localAuthority in Model.SingleDeclarationJourney.LocalAuthorityList)
                        {
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input"
                                       id="SelectLa"
                                       name="SelectedLa"
                                       type="radio"
                                       value="@localAuthority.OnsCode"
                                       asp-for="SelectedLa">
                                <label class="govuk-label govuk-radios__label" for="SelectLa">
                                    @localAuthority.Name
                                </label>
                            </div>
                        }
                    }

                </div>
            </fieldset>
        </div>

        <!-- buttons block -->
        <div class="govuk-button-group govuk-!-margin-top-8">
            <button type="submit" class="govuk-button" data-module="govuk-button">
                Continue
            </button>

            <a class="govuk-link" asp-page="@LafPages.SendDeclaration.ROUTE">
                Cancel
            </a>
        </div>

    </form>
}
