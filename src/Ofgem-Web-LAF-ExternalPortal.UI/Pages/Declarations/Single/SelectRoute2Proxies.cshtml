@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Ofgem_Web_LAF_ExternalPortal.Extensions
@model SelectRoute2Proxies
@{
    ViewData["Title"] = "Route 2 Proxies - LA Flex - Ofgem";
}
<input id="menuToSelect" type="hidden" value="@(LafPageMenus.SEND_DECLARATIONS)" />

<a data-test-id="BackButton" asp-page="@LafPages.SelectReferralRoute.ROUTE" class="govuk-back-link">Back</a>

<!-- Error summary  -->
@if (Model.HasError)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">
                There is a problem
            </h2>
            <div class="govuk-error-summary__body">
                <ul data-test-id="ErrorList" class="govuk-list govuk-error-summary__list laflex-error-list">
                    <li>
                        <a href="#@Model.ErrorId"> @Model.DisplayMessage</a>
                    </li>
                </ul>
                <br />
            </div>
        </div>
    </div>
}

<form method="POST">
    <main class="govuk-main-wrapper " id="main-content" role="main">
        <span class="govuk-caption-l">Create a single declaration notification</span>
        <div class="govuk-form-group @(Model.HasError ? "govuk-form-group--error" : "")">
            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                    <h1 class="govuk-fieldset__heading">
                        What were the proxies that the household was referred under?
                    </h1>
                </legend>
                <div class="govuk-radios" data-module="govuk-radios">
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input"
                               id="Route2Proxy1"
                               type="radio"
                               value="@Route2Proxy.Route2Proxy1Text"
                               asp-for="SelectedRoute2Proxy">

                        <label class="govuk-label govuk-radios__label" for="Route2Proxy1">
                            @Route2Proxy.Route2Proxy1Text
                        </label>
                    </div>
                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input"
                               id="Route2Proxy2"
                               type="radio"
                               value="@Route2Proxy.Route2Proxy2Text"
                               asp-for="SelectedRoute2Proxy">

                        <label class="govuk-label govuk-radios__label" for="Route2Proxy2">
                            @Route2Proxy.Route2Proxy2Text
                        </label>

                    </div>

                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input"
                               id="Route2Proxy3"
                               type="radio"
                               value="@Route2Proxy.Route2Proxy3Text"
                               asp-for="SelectedRoute2Proxy">

                        <label class="govuk-label govuk-radios__label" for="Route2Proxy3">
                            @Route2Proxy.Route2Proxy3Text
                        </label>

                    </div>

                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input"
                               id="Route2Proxy4"
                               type="radio"
                               value="@Route2Proxy.Route2Proxy4Text"
                               asp-for="SelectedRoute2Proxy">

                        <label class="govuk-label govuk-radios__label" for="Route2Proxy4">
                            @Route2Proxy.Route2Proxy4Text
                        </label>

                    </div>

                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input"
                               id="Route2Proxy5"
                               type="radio"
                               value="@Route2Proxy.Route2Proxy5Text"
                               asp-for="SelectedRoute2Proxy">

                        <label class="govuk-label govuk-radios__label" for="Route2Proxy5">
                            @Route2Proxy.Route2Proxy5Text
                        </label>

                    </div>

                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input"
                               id="Route2Proxy6"
                               type="radio"
                               value="@Route2Proxy.Route2Proxy6Text"
                               asp-for="SelectedRoute2Proxy">

                        <label class="govuk-label govuk-radios__label" for="Route2Proxy6">
                            @Route2Proxy.Route2Proxy6Text
                        </label>

                    </div>

                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input"
                               id="Route2Proxy7PPM"
                               type="radio"
                               value="@Route2Proxy.Route2Proxy7PPMText"
                               asp-for="SelectedRoute2Proxy">

                        <label class="govuk-label govuk-radios__label" for="Route2Proxy7PPM">
                            @Route2Proxy.Route2Proxy7PPMText
                        </label>

                    </div>

                    <div class="govuk-radios__item">
                        <input class="govuk-radios__input"
                               id="Route2Proxy7NonPPM"
                               type="radio"
                               value="@Route2Proxy.Route2Proxy7NonPPMText"
                               asp-for="SelectedRoute2Proxy">

                        <label class="govuk-label govuk-radios__label" for="Route2Proxy7NonPPM">
                            @Route2Proxy.Route2Proxy7NonPPMText
                        </label>

                    </div>

                </div>

            </fieldset>

        </div>


        <div class="govuk-button-group govuk-!-margin-top-8">

            <button class="govuk-button" data-module="govuk-button">
                Continue
            </button>

            <a class="govuk-link" asp-page="@LafPages.SendDeclaration.ROUTE">
                Cancel
            </a>

        </div>


    </main>

</form>