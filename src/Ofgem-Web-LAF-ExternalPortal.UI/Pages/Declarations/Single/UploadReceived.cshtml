@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Ofgem_Web_LAF_ExternalPortal.Extensions
@model Ofgem_Web_LAF_ExternalPortal.Pages.Declarations.Single.UploadReceived
@{
    ViewData["Title"] = "Upload Received - LA Flex - Ofgem";
}

<a data-test-id="BackButton" asp-page="@LafPages.SelectReferralRoute.ROUTE" class="govuk-back-link">Back</a>


@if (Model != null)
{
    <!-- Error summary  -->
    @if (Model.HasError)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">
                    There is a problem
                </h2>
                <div class="govuk-error-summary__body">
                    <ul data-test-id="ErrorList" class="govuk-list govuk-error-summary__list laflex-error-list">
                        <li>
                            <a href="#@Model.ErrorId"> @Model.DisplayMessage</a>
                        </li>
                    </ul>
                    <br />
                </div>
            </div>
        </div>
    }

    <form method="POST">
    </form>
}