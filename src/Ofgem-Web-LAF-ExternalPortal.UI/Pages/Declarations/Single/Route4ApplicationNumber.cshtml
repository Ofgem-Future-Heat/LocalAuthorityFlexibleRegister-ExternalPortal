@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Ofgem_Web_LAF_ExternalPortal.Extensions
@model Ofgem_Web_LAF_ExternalPortal.Pages.Declarations.Single.Route4ApplicationNumber
@{
    ViewData["Title"] = "Route 4 application number - LA Flex - Ofgem";
}

<input id="menuToSelect" type="hidden" value="@(LafPageMenus.SEND_DECLARATIONS)" />

<a data-test-id="BackButton" asp-page="@LafPages.SelectReferralRoute.ROUTE" class="govuk-back-link">Back</a>

@if (Model != null)
{
    <!-- Error summary  -->
    @if (Model.HasError)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">
                    There is a problem
                </h2>
                <div class="govuk-error-summary__body">
                    <ul data-test-id="ErrorList" class="govuk-list govuk-error-summary__list laflex-error-list">
                        <li>
                            <a href="#@Model.ErrorId"> @Model.DisplayMessage</a>
                        </li>
                    </ul>
                    <br />
                </div>
            </div>
        </div>
    }

    @if (Model.SingleDeclarationJourney is not null)
    {
        <form method="POST">
            <span class="govuk-caption-l">Create a single declaration notification</span>

            <div class="govuk-form-group @(Model.HasError ? "govuk-form-group--error" : "")">
                <fieldset class="govuk-fieldset" role="group">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
                        <h1 class="govuk-fieldset__heading">
                            What is the route 4 application number?
                        </h1>
                    </legend>
                    <div id="urn-number-hint" class="govuk-hint  govuk-!-width-two-thirds">
                        Please provide the unique 5 digit application number for the ECO4 flex route 4 application.
                    </div>
                    <br>
                    <input class="govuk-input govuk-input--width-20" 
                           id="ApplicationNumber"
                           name="ApplicationNumber"
                           type="number" maxlength="5"
                           asp-for="ApplicationNumber"
                           aria-describedby="urn-number-hint">

                </fieldset>
            </div>

            <div class="govuk-button-group govuk-!-margin-top-8">
                <button class="govuk-button" data-module="govuk-button">
                    Continue
                </button>

                <a class="govuk-link" asp-page="@LafPages.SendDeclaration.ROUTE">
                    Cancel
                </a>

            </div>
        </form>
    }
}
