@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Ofgem_Web_LAF_ExternalPortal.Extensions
@model Ofgem_Web_LAF_ExternalPortal.Pages.Declarations.Single.SelectStatementOfIntentModel
@{
    ViewData["Title"] = "Select statement of intent - LA Flex - Ofgem";
}

<input id="menuToSelect" type="hidden" value="@(LafPageMenus.SEND_DECLARATIONS)" />


<a data-test-id="BackButton" asp-page="@LafPages.SelectLocalAuthority.ROUTE" class="govuk-back-link">Back</a>

<!-- Error summary  -->
@if (Model.HasError)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">
                There is a problem
            </h2>
            <div class="govuk-error-summary__body">
                <ul data-test-id="ErrorList" class="govuk-list govuk-error-summary__list laflex-error-list">
                    <li>
                        <a href="#@Model.ErrorId"> @Model.DisplayMessage</a>
                    </li>
                </ul>
                <br />
            </div>
        </div>
    </div>
}

@if (Model.SingleDeclarationJourney is not null)
{
    <form method="POST">

        <input type="hidden" asp-for="AvailableSoiList" />

        <span class="govuk-caption-l">Create a single declaration notification</span>

        <div class="govuk-form-group @(Model.HasError ? "govuk-form-group--error" : "")">

            <fieldset class="govuk-fieldset">

                <legend class="govuk-fieldset__legend govuk-fieldset__legend--l govuk-!-margin-bottom-6">

                    <h1 class="govuk-fieldset__heading">
                        Select the Statement of Intent to use
                    </h1>

                </legend>

                <div class="govuk-radios" data-module="govuk-radios">

                    @if (Model.AvailableSoiList is { Count: > 0 })
                    {
                        @foreach (var soi in Model.AvailableSoiList)
                        {
                            <div class="govuk-radios__item">
                                <input class="govuk-radios__input" id="SelectSoi"
                                       name="SelectedSoi" type="radio"
                                       value="@soi.StatementOfIntentId"
                                       asp-for="SelectedSoi">
                                
                                <label class="govuk-label govuk-radios__label" for="SelectSoi">
                                    @soi.VersionNumber : added @soi.DateAdded?.ToString("dd/MM/yyyy")
                                </label>

                                <div id="signIn-item-hint" class="govuk-hint govuk-radios__hint">
                                    Status: @soi.SoiStatus
                                </div>

                            </div>
                        }
                    }

                </div>
            </fieldset>
        </div>

        <!-- buttons block -->
        <div class="govuk-button-group govuk-!-margin-top-8">
            <button type="submit" class="govuk-button" data-module="govuk-button">
                Continue
            </button>

            <a class="govuk-link" asp-page="@LafPages.SendDeclaration.ROUTE">
                Cancel
            </a>
        </div>

    </form>
}