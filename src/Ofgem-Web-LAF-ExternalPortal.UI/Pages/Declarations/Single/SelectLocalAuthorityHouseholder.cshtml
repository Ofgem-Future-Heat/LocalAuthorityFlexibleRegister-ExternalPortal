@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Ofgem_Web_LAF_ExternalPortal.Extensions
@model Ofgem_Web_LAF_ExternalPortal.Pages.Declarations.Single.SelectLocalAuthorityHouseholder
@{
    ViewData["Title"] = "Declaration unique reference number - LA Flex - Ofgem";
}

<input id="menuToSelect" type="hidden" value="@(LafPageMenus.SEND_DECLARATIONS)" />


<a data-test-id="BackButton" asp-page="@LafPages.UniqueReferenceNumber.ROUTE" class="govuk-back-link">Back</a>

<!-- Error summary  -->
@if (Model.HasError)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">
                There is a problem
            </h2>
            <div class="govuk-error-summary__body">
                <ul data-test-id="ErrorList" class="govuk-list govuk-error-summary__list laflex-error-list">
                    <li>
                        <a href="#@Model.ErrorId"> @Model.DisplayMessage</a>
                    </li>
                </ul>
                <br />
            </div>
        </div>
    </div>
}

@if (Model.SingleDeclarationJourney is not null)
{
    <form method="POST">

        <span class="govuk-caption-l">Create a single declaration notification</span>
        <div class="govuk-form-group @(Model.HasError ? "govuk-form-group--error" : "")">
            <h1 class="govuk-label-wrapper">
                <label class="govuk-label govuk-label--l" for="SelectedLocalAuthorityHouseholder">
                    What is the local authority area code of the household?
                </label>
            </h1>

            <div id="SelectedLaAreaCode-hint" class="govuk-hint govuk-hint govuk-!-margin-bottom-5">
                9-digit Office for National Statistics (ONS) code. It should be 1 letter followed by 8 numbers.
            </div>

            <input class="govuk-input govuk-input--width-20" 
                   type="text"
                   asp-for="SelectedLocalAuthorityHouseholder"
                   aria-describedby="SelectedLaAreaCode-hint">
        </div>

        <div class="govuk-button-group govuk-!-margin-top-8">
            <button type="submit" class="govuk-button" data-module="govuk-button">
                Continue
            </button>

            <a class="govuk-link" asp-page="@LafPages.SendDeclaration.ROUTE">
                Cancel
            </a>
        </div>

    </form>
}
